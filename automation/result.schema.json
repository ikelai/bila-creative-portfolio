{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bila.tw/schemas/website-result.json",
  "title": "BILA Website Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "completed_at", "status", "branch", "commit", "checks", "artifacts", "notes"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^BW-[0-9]{4}-[0-9]{4}$"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["BLOCKED", "SUBMITTED"]},
    "branch": {"type": "string", "pattern": "^agent/"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "pull_request": {"type": ["string", "null"], "format": "uri"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "passed"], "properties": {"name": {"type": "string"}, "passed": {"type": "boolean"}}}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
