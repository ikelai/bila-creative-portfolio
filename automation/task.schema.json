{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bila.tw/schemas/website-task.json",
  "title": "BILA Website Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "project_id", "issued_at", "status", "scope", "inputs", "acceptance", "safety"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^BW-[0-9]{4}-[0-9]{4}$"},
    "project_id": {"const": "P-2026-0005"},
    "issued_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["READY", "CLAIMED", "BLOCKED", "SUBMITTED", "ACCEPTED", "REJECTED"]},
    "scope": {"type": "string", "minLength": 10},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "location", "access"],
        "properties": {
          "kind": {"enum": ["GITHUB", "CURATED_LIBRARY", "WIX", "DECISION"]},
          "location": {"type": "string", "minLength": 1},
          "access": {"enum": ["READ_ONLY", "READ_WRITE"]}
        }
      }
    },
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nas_originals", "direct_main_push", "secrets_in_repo"],
      "properties": {
        "nas_originals": {"const": "READ_ONLY"},
        "direct_main_push": {"const": false},
        "secrets_in_repo": {"const": false}
      }
    }
  }
}
